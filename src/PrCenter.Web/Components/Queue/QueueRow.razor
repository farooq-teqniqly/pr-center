@using PrCenter.Core.Derivation
@inject TimeProvider TimeProvider

<div class="row @(Item.HasUpdate ? "row-unseen" : null) @(Item.AuthoredByMe ? "row-mine" : null)" data-testid="pr" data-pr-id="@Item.Identity.Id">
    <div class="stripe"></div>
    <div class="row-main">
        <div class="title-line">
            <span class="pr-num">#@Item.Identity.Number</span>
            <span class="pr-title">
                @if (LinksOverHttps)
                {
                    <a href="@Item.Identity.Url" target="_blank" rel="noopener noreferrer" data-testid="pr-title-link">@Item.Identity.Title</a>
                }
                else
                {
                    <span data-testid="pr-title-text">@Item.Identity.Title</span>
                }
            </span>
            @if (Item.HasUpdate)
            {
                <span class="upd-badge" data-testid="updated-badge">Updated</span>
            }
            @if (Item.IsAlreadyCovered)
            {
                <span class="covered" data-testid="covered-badge">covered &middot; @string.Join(", ", Item.CoveredBy)</span>
            }
            @if (Item.AuthoredByMe)
            {
                <span class="mine" data-testid="mine-badge">mine</span>
            }
        </div>
        <div class="byline" data-testid="byline">@Item.LastUpdate.By &middot; @RelativeTime.Format(Item.LastUpdate.At, _renderedAt)</div>
        <RosterChips Roster="Item.Roster" />
    </div>
    <div class="times">
        <span class="k">updated</span>
        <span class="v" data-testid="last-update-at">@RelativeTime.Format(Item.LastUpdate.At, _renderedAt)</span>
        <span class="k">I reviewed</span>
        <span class="v" data-testid="last-reviewed-at">@LastReviewedText()</span>
    </div>
</div>

@code {
    /// <summary>The queue item this row renders.</summary>
    [Parameter]
    [EditorRequired]
    public QueueItem Item { get; set; } = null!;

    private DateTimeOffset _renderedAt;

    // Captured once per render: every relative time in this row measures from the
    // same instant, so a render that straddles a minute boundary cannot show one
    // field as "5m ago" and another as "6m ago".
    protected override void OnParametersSet() => _renderedAt = TimeProvider.GetUtcNow();

    // Only an absolute https URL becomes a link. The value comes from GitHub's own
    // API today, but nothing in the type stops a javascript:/data: scheme from
    // reaching the anchor, so an unrecognized URL renders as plain text instead.
    private bool LinksOverHttps =>
        Uri.TryCreate(Item.Identity.Url, UriKind.Absolute, out var url)
        && string.Equals(url.Scheme, Uri.UriSchemeHttps, StringComparison.Ordinal);

    private string LastReviewedText() =>
        Item.MyEngagement.LastReviewedAt is { } lastReviewedAt
            ? RelativeTime.Format(lastReviewedAt, _renderedAt)
            : "never";
}
