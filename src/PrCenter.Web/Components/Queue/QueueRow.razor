@using PrCenter.Core.Derivation
@inject TimeProvider TimeProvider

<div class="row @(Item.HasUpdate ? "row-unseen" : null)" data-testid="pr" data-pr-id="@Item.Identity.Id">
    <div class="stripe"></div>
    <div class="row-main">
        <div class="title-line">
            <span class="pr-num">#@Item.Identity.Number</span>
            <span class="pr-title">
                <a href="@Item.Identity.Url" target="_blank" rel="noopener noreferrer" data-testid="pr-title-link">@Item.Identity.Title</a>
            </span>
            @if (Item.HasUpdate)
            {
                <span class="upd-badge" data-testid="updated-badge">Updated</span>
            }
            @if (Item.IsAlreadyCovered)
            {
                <span class="covered" data-testid="covered-badge">covered &middot; @string.Join(", ", Item.CoveredBy)</span>
            }
        </div>
        <div class="byline" data-testid="byline">@Item.LastUpdate.By &middot; @RelativeTime.Format(Item.LastUpdate.At, Now)</div>
        <RosterChips Roster="Item.Roster" />
    </div>
    <div class="times">
        <span class="k">updated</span>
        <span class="v" data-testid="last-update-at">@RelativeTime.Format(Item.LastUpdate.At, Now)</span>
        <span class="k">I reviewed</span>
        <span class="v" data-testid="last-reviewed-at">@LastReviewedText()</span>
    </div>
</div>

@code {
    /// <summary>The queue item this row renders.</summary>
    [Parameter]
    [EditorRequired]
    public QueueItem Item { get; set; } = null!;

    private DateTimeOffset Now => TimeProvider.GetUtcNow();

    private string LastReviewedText() =>
        Item.MyEngagement.LastReviewedAt is { } lastReviewedAt
            ? RelativeTime.Format(lastReviewedAt, Now)
            : "never";
}
