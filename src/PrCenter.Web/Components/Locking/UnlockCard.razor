@using Microsoft.Extensions.Logging
@using PrCenter.Core.Ports
@using PrCenter.Core.Queue
@inject UnlockApp UnlockApp
@inject ITokenVault TokenVault
@inject ILogger<UnlockCard> Logger

<div class="card shadow-sm mx-auto" style="max-width: 24rem;" data-testid="unlock-card">
    <div class="card-body">
        <h1 class="card-title h4 mb-3">Unlock PR-Center</h1>

        <label for="unlock-password" class="form-label">App password</label>
        <input id="unlock-password"
               type="password"
               class="form-control"
               data-testid="password"
               @bind="_password"
               @bind:event="onchange" />

        @if (_wrongPassword)
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert" data-testid="unlock-error">
                That password is not correct.
            </div>
        }

        @if (_unlockFailed)
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert" data-testid="unlock-failure">
                Unable to unlock: the stored vault data could not be read.
            </div>
        }

        <div class="d-grid mt-3">
            <button type="button"
                    class="btn btn-primary"
                    data-testid="unlock-submit"
                    @onclick="SubmitAsync">
                Unlock
            </button>
        </div>

        @if (_confirmingReset)
        {
            <div class="border border-danger rounded p-3 mt-3" data-testid="reset-confirmation">
                <p class="small mb-2">
                    Resetting destroys your app password and every stored owner
                    token. Nothing can be recovered: you will set a new app
                    password and re-enter each token. Type
                    <strong>@ConfirmationWord</strong> to confirm.
                </p>

                <label for="reset-confirm-word" class="form-label visually-hidden">
                    Type @ConfirmationWord to confirm
                </label>
                <input id="reset-confirm-word"
                       type="text"
                       class="form-control"
                       data-testid="reset-confirm-word"
                       @bind="_confirmationWord"
                       @bind:event="onchange" />

                @if (_confirmationMismatched)
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert" data-testid="reset-mismatch">
                        Type @ConfirmationWord exactly to confirm the reset.
                    </div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm flex-fill"
                            data-testid="reset-cancel"
                            @onclick="CancelReset">
                        Cancel
                    </button>
                    <button type="button"
                            class="btn btn-danger btn-sm flex-fill"
                            data-testid="reset-confirm"
                            @onclick="ConfirmResetAsync">
                        Reset everything
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="text-center mt-3">
                <button type="button"
                        class="btn btn-link btn-sm text-danger"
                        data-testid="reset-vault"
                        @onclick="BeginReset">
                    Forgot password? Reset the app password and all tokens
                </button>
            </div>
        }
    </div>
</div>

@code {
    private const string ConfirmationWord = "RESET";

    private string _password = string.Empty;
    private bool _wrongPassword;
    private bool _unlockFailed;
    private bool _confirmingReset;
    private string _confirmationWord = string.Empty;
    private bool _confirmationMismatched;

    /// <summary>Invoked after a successful unlock, so the gate can re-evaluate.</summary>
    [Parameter]
    public EventCallback OnUnlocked { get; set; }

    /// <summary>Invoked after the vault is reset, so the gate can re-evaluate.</summary>
    [Parameter]
    public EventCallback OnReset { get; set; }

    private async Task SubmitAsync()
    {
        _wrongPassword = false;
        _unlockFailed = false;

        if (string.IsNullOrWhiteSpace(_password))
        {
            _wrongPassword = true;
            return;
        }

        try
        {
            var unlocked = await UnlockApp.UnlockAsync(_password);
            if (unlocked)
            {
                await OnUnlocked.InvokeAsync();
            }
            else
            {
                _wrongPassword = true;
            }
        }
        // An unreadable vault (no password set, unsupported KDF version, corrupt
        // stored data) is distinct from a wrong password. Left unhandled it faults
        // the circuit and the card stops responding, so it is surfaced on the card.
        catch (InvalidOperationException ex)
        {
            LogUnlockFailed(Logger, ex);
            _unlockFailed = true;
        }
    }

    private void BeginReset()
    {
        _confirmingReset = true;
        _confirmationWord = string.Empty;
        _confirmationMismatched = false;
    }

    private void CancelReset() => _confirmingReset = false;

    private async Task ConfirmResetAsync()
    {
        // Ordinal and case-sensitive: the typed word is a deliberate act, not a
        // value to be helpfully interpreted, and this is the one action with no
        // recovery.
        if (!string.Equals(_confirmationWord, ConfirmationWord, StringComparison.Ordinal))
        {
            _confirmationMismatched = true;
            return;
        }

        await TokenVault.ResetVaultAsync();
        _confirmingReset = false;
        await OnReset.InvokeAsync();
    }
}
